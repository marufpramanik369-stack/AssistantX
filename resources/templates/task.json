{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assistantx://templates/task",
  "title": "AssistantX Task",
  "description": "Standard task structure for scheduled and productivity operations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "status",
    "priority"
  ],
  "properties": {
    "id": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "scheduled",
        "running",
        "completed",
        "cancelled",
        "failed",
        "paused"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "scheduled_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "recurrence": {
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
