{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assistantx://templates/search-result",
  "title": "AssistantX Search Result",
  "description": "Normalized structure for web search results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query",
    "results"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "snippet": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "relevance": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "total_results": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "search_engine": {
      "type": [
        "string",
        "null"
      ]
    },
    "searched_at": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
