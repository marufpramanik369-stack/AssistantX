{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assistantx://templates/command",
  "title": "AssistantX Command",
  "description": "Normalized command representation for AssistantX actions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "action",
    "parameters"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "confirmation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "scheduler",
        "plugin",
        "system"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
