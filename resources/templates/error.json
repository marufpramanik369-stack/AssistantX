{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assistantx://templates/error",
  "title": "AssistantX Error",
  "description": "Standardized error structure used across AssistantX subsystems.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "error_code",
    "message",
    "recoverable"
  ],
  "properties": {
    "success": {
      "const": false
    },
    "error_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": [
        "string",
        "null"
      ]
    },
    "subsystem": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ai",
        "automation",
        "browser",
        "database",
        "filesystem",
        "voice",
        "plugin",
        "scheduler",
        "configuration",
        "network",
        "unknown",
        null
      ]
    },
    "recoverable": {
      "type": "boolean"
    },
    "retry": {
      "type": "boolean"
    },
    "retry_after_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
