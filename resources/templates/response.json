{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assistantx://templates/response",
  "title": "AssistantX Response",
  "description": "Standard response structure for AssistantX user-facing responses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "message",
    "response_type"
  ],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "response_type": {
      "type": "string",
      "enum": [
        "text",
        "code",
        "list",
        "confirmation",
        "error",
        "warning",
        "notification",
        "result"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "conversation_id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
