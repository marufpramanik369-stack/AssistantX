# AssistantX Environment Configuration
# Copy this file to .env and add your own credentials.

APP_NAME=AssistantX
APP_VERSION=1.0.0
APP_ENV=development

# AI Provider
AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HOST=127.0.0.1
OLLAMA_MODEL=llama3

# Weather and News
OPENWEATHER_API_KEY=
NEWSAPI_KEY=

# Search and Translation
SEARCH_API_KEY=
TRANSLATION_API_KEY=

# Database and Security
DATABASE_URL=
SECRET_KEY=

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# Voice
VOICE_ENABLED=true
SPEECH_LANGUAGE=bn-BD
TTS_LANGUAGE=bn
TTS_RATE=170
TTS_VOLUME=1.0

# General
DEBUG=false
LOG_LEVEL=INFO
