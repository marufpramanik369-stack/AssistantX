# ============================================================================
# AssistantX - Environment Configuration Template
# ============================================================================
#
# IMPORTANT:
#   - Copy this file to ".env" for local development.
#   - NEVER commit ".env" to Git.
#   - Keep real API keys, passwords, tokens and secrets only in ".env".
#
# Example:
#   cp .env.example .env
#
# ============================================================================


# ============================================================================
# 01. APPLICATION
# ============================================================================

APP_NAME=AssistantX
APP_VERSION=1.0.0

# development | testing | production
APP_ENV=development

# true | false
DEBUG=true

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Enable detailed startup diagnostics
STARTUP_DIAGNOSTICS=true


# ============================================================================
# 02. AI PROVIDER
# ============================================================================

# Available providers:
#   gemini
#   ollama
#   local
#
# Recommended for fully local/offline development:
#   AI_PROVIDER=ollama

AI_PROVIDER=ollama

# Maximum number of provider retry attempts
AI_MAX_RETRIES=2

# Request timeout in seconds
AI_REQUEST_TIMEOUT=60

# Default generation temperature
AI_TEMPERATURE=0.7


# ============================================================================
# 03. GOOGLE GEMINI
# ============================================================================

# Get your API key from Google AI Studio.
# Leave empty if Gemini is not being used.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini configuration
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048


# ============================================================================
# 04. OLLAMA - LOCAL AI
# ============================================================================

# Default local Ollama server
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Example:
#   llama3.2
#   qwen2.5
#   gemma3
#
# Leave empty if you have not selected a model yet.

OLLAMA_MODEL=

OLLAMA_TIMEOUT=120


# ============================================================================
# 05. LOCAL AI
# ============================================================================

# Configuration for custom/local AI backends.

LOCAL_AI_ENABLED=false
LOCAL_AI_MODEL=
LOCAL_AI_BASE_URL=

# Optional local model path
LOCAL_AI_MODEL_PATH=


# ============================================================================
# 06. CONVERSATION & MEMORY
# ============================================================================

# Enable conversation history
CONVERSATION_HISTORY_ENABLED=true

# Enable long-term assistant memory
MEMORY_ENABLED=true

# Maximum number of messages kept in active context
MAX_CONTEXT_MESSAGES=20

# Maximum memory items loaded into context
MAX_MEMORY_ITEMS=50


# ============================================================================
# 07. VOICE ASSISTANT
# ============================================================================

VOICE_ENABLED=true

# Enable wake-word detection
WAKE_WORD_ENABLED=true

# Wake word used by the assistant
WAKE_WORD=assistantx

# Speech recognition language
SPEECH_LANGUAGE=en-US

# Supported examples:
#   en-US
#   en-GB
#   bn-BD

# Text-to-Speech language
TTS_LANGUAGE=en

# Speech rate
TTS_RATE=170

# Speech volume: 0.0 - 1.0
TTS_VOLUME=1.0

# Automatically speak AI responses
TTS_AUTO_SPEAK=true


# ============================================================================
# 08. WEB SEARCH
# ============================================================================

SEARCH_ENABLED=true

# Optional search API key
SEARCH_API_KEY=

# Maximum search results
SEARCH_MAX_RESULTS=10

# Search timeout
SEARCH_TIMEOUT=15


# ============================================================================
# 09. WEATHER SERVICE
# ============================================================================

WEATHER_ENABLED=true

# Optional weather provider API key
WEATHER_API_KEY=

# Default weather unit:
#   metric
#   imperial

WEATHER_UNIT=metric


# ============================================================================
# 10. NEWS SERVICE
# ============================================================================

NEWS_ENABLED=true

# Optional news API key
NEWS_API_KEY=

NEWS_MAX_RESULTS=10


# ============================================================================
# 11. TRANSLATION
# ============================================================================

TRANSLATION_ENABLED=true

# Optional translation provider API key
TRANSLATION_API_KEY=


# ============================================================================
# 12. WIKIPEDIA
# ============================================================================

WIKIPEDIA_ENABLED=true

WIKIPEDIA_LANGUAGE=en


# ============================================================================
# 13. EMAIL
# ============================================================================

EMAIL_ENABLED=false

# SMTP configuration
SMTP_HOST=
SMTP_PORT=587

SMTP_USERNAME=
SMTP_PASSWORD=

# Sender address
EMAIL_FROM=

# TLS / SSL
SMTP_USE_TLS=true
SMTP_USE_SSL=false


# ============================================================================
# 14. DATABASE
# ============================================================================

# Leave empty to use AssistantX's default local SQLite database.
#
# Example:
# DATABASE_URL=sqlite:///database/assistantx.db

DATABASE_URL=

# Enable automatic database migrations
DATABASE_AUTO_MIGRATE=true


# ============================================================================
# 15. SECURITY
# ============================================================================

# IMPORTANT:
# Replace this with a strong random value in your real ".env".
#
# Example:
# SECRET_KEY=change-this-to-a-long-random-secret

SECRET_KEY=

# Session security
SESSION_TIMEOUT=3600


# ============================================================================
# 16. CACHE
# ============================================================================

CACHE_ENABLED=true

# Cache lifetime in seconds
CACHE_TTL=3600

# Maximum cache size in MB
CACHE_MAX_SIZE_MB=512

# Automatically remove expired cache files
CACHE_AUTO_CLEAN=true


# ============================================================================
# 17. LOGGING
# ============================================================================

LOGGING_ENABLED=true

# Write logs to files
FILE_LOGGING_ENABLED=true

# Maximum log file size in MB
LOG_MAX_SIZE_MB=10

# Number of rotated log files
LOG_BACKUP_COUNT=5


# ============================================================================
# 18. NOTIFICATIONS
# ============================================================================

NOTIFICATIONS_ENABLED=true

# Notification duration in seconds
NOTIFICATION_TIMEOUT=8


# ============================================================================
# 19. AUTOMATION
# ============================================================================

# Enable desktop automation
AUTOMATION_ENABLED=true

# Keyboard automation
KEYBOARD_AUTOMATION_ENABLED=true

# Mouse automation
MOUSE_AUTOMATION_ENABLED=true

# File operations
FILE_AUTOMATION_ENABLED=true

# Browser automation
BROWSER_AUTOMATION_ENABLED=true

# Screenshot functionality
SCREENSHOT_ENABLED=true


# ============================================================================
# 20. SCHEDULER
# ============================================================================

SCHEDULER_ENABLED=true

# Check scheduled tasks every N seconds
SCHEDULER_INTERVAL=30


# ============================================================================
# 21. PLUGINS
# ============================================================================

PLUGINS_ENABLED=true

# Automatically load installed plugins
PLUGIN_AUTO_LOAD=true

# Allow third-party plugins
THIRD_PARTY_PLUGINS_ENABLED=false


# ============================================================================
# 22. DASHBOARD / UI
# ============================================================================

UI_THEME=dark

# Enable UI animations
UI_ANIMATIONS=true

# Enable particle effects
UI_PARTICLES=true

# Enable splash screen
UI_SPLASH_SCREEN=true

# Start dashboard maximized
UI_START_MAXIMIZED=false


# ============================================================================
# 23. UPDATES
# ============================================================================

UPDATE_CHECK_ENABLED=true

# Check for updates every N hours
UPDATE_CHECK_INTERVAL=24

# Optional update endpoint
UPDATE_URL=


# ============================================================================
# 24. TELEMETRY & PRIVACY
# ============================================================================

# AssistantX should remain privacy-friendly by default.
#
# Set true only if you intentionally implement telemetry.

TELEMETRY_ENABLED=false

# Send anonymous usage statistics
ANONYMOUS_USAGE_STATS=false


# ============================================================================
# 25. DEVELOPMENT / TESTING
# ============================================================================

TEST_MODE=false

# Enable developer tools
DEVELOPER_MODE=false

# Enable verbose debugging
VERBOSE_DEBUG=false


# ============================================================================
# END OF CONFIGURATION
# ============================================================================

